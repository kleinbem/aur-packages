pkgbase = mesh-llm-git
	pkgdesc = Pool spare GPU capacity to run LLMs at larger scale (git main)
	pkgver = 0.78.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/Mesh-LLM/mesh-llm
	arch = x86_64
	arch = aarch64
	license = Apache-2.0 OR MIT
	checkdepends = curl
	checkdepends = python
	makedepends = cargo
	makedepends = cmake
	makedepends = gcc-libs
	makedepends = git
	makedepends = ninja
	makedepends = nodejs
	makedepends = patchelf
	makedepends = pnpm
	makedepends = protobuf
	makedepends = python
	makedepends = shaderc
	makedepends = spirv-headers
	makedepends = vulkan-headers
	makedepends = vulkan-icd-loader
	options = !lto
	options = !debug
	source = mesh-llm::git+https://github.com/Mesh-LLM/mesh-llm.git
	source = llama.cpp::git+https://github.com/ggml-org/llama.cpp.git
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = mesh-llm-git
	depends = glibc
	depends = libgcc
	depends = skippy-native-runtime-git
	optdepends = skippy-native-runtime-vulkan-git: Vulkan GPU inference
	provides = mesh-llm
	conflicts = mesh-llm
	conflicts = mesh-llm-cuda
	conflicts = mesh-llm-rocm
	conflicts = mesh-llm-vulkan

pkgname = skippy-git
	pkgdesc = Single-model LLM server with OpenAI and Anthropic APIs, from MeshLLM (git main)
	depends = glibc
	depends = libgcc
	depends = skippy-native-runtime-git
	optdepends = skippy-native-runtime-vulkan-git: Vulkan GPU inference
	provides = skippy
	conflicts = skippy

pkgname = skippy-native-runtime-git
	pkgdesc = Patched llama.cpp libraries that Skippy and MeshLLM load, CPU backend (git main)
	license = MIT AND (Apache-2.0 OR MIT)
	depends = glibc
	depends = libgcc
	depends = libgomp
	depends = libstdc++
	provides = skippy-native-runtime
	conflicts = skippy-native-runtime
	options = !strip

pkgname = skippy-native-runtime-vulkan-git
	pkgdesc = Patched llama.cpp libraries that Skippy and MeshLLM load, Vulkan backend (git main)
	license = MIT AND (Apache-2.0 OR MIT)
	depends = glibc
	depends = libgcc
	depends = libgomp
	depends = libstdc++
	depends = vulkan-icd-loader
	provides = skippy-native-runtime-vulkan
	conflicts = skippy-native-runtime-vulkan
	options = !strip
