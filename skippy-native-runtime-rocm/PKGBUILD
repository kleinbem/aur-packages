# Maintainer: Martin Kleinberger <martin dot kleinberger at gmail dot com>

pkgname=skippy-native-runtime-rocm
pkgver=0.79.0
pkgrel=1
pkgdesc="Patched llama.cpp libraries that Skippy and MeshLLM load, ROCm backend"
arch=(x86_64)
url="https://github.com/Mesh-LLM/mesh-llm"
license=('MIT AND (Apache-2.0 OR MIT)')
depends=(glibc hip-runtime-amd hipblas libgcc libgomp libstdc++)
makedepends=(cargo cmake git ninja patchelf python rocm-toolchain)
# !strip: the bundle's manifest.json checksums every library. !debug: with
# !strip, the debuginfo would stay in the libraries.
options=(!lto !strip !debug)
# MeshLLM only loads a runtime of its own version.
conflicts=("mesh-llm<$pkgver" "mesh-llm>$pkgver" "skippy<$pkgver" "skippy>$pkgver")
install=skippy-native-runtime.install
# MeshLLM needs llama.cpp at the release it pins (skippy/llama_cpp/upstream.txt)
# plus its patch queue, applied with git, so the runtimes are built here rather
# than from a generic llama.cpp package (nixpkgs' skippy-native-runtime does the same).
_llamacpp=b12199
# Speech recognition builds whisper.cpp at the commit upstream pins.
_whisper=231638a0717b7822784297e5980965ffcec05810
source=(
  "mesh-llm-$pkgver.tar.gz::https://github.com/Mesh-LLM/mesh-llm/archive/refs/tags/v$pkgver.tar.gz"
  "llama.cpp::git+https://github.com/ggml-org/llama.cpp.git#tag=$_llamacpp"
  "whisper.cpp::git+https://github.com/ggml-org/whisper.cpp.git#commit=$_whisper"
)
sha256sums=('60666ab66e50844a658ac0dbbdd9ad206ef7927275e6050619f1634ba96ab569'
            'ff9169018a2b8a3221c114db0291ab44f010ef68dd9eb7ef9fa9ddc02ab37e43'
            '54a11fee8f24cce21f11abdbc0695776736189beb15ba4e21a35dac97e3bf442')

# GPU targets of upstream's ROCm release runtime (release.yml).
_amdgpu_targets='gfx90a;gfx942;gfx1100;gfx1101;gfx1102;gfx1103;gfx1151;gfx1200;gfx1201'

_cargo_env() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Upstream's cargo config builds through sccache and its own linker drivers;
  # these override it with plain rustc and cc.
  # no-link: upstream keeps both in its config on purpose.
  export CARGO_BUILD_RUSTC_WRAPPER=
  local triple
  triple=$(rustc --print host-tuple)
  triple=${triple//-/_}
  export "CARGO_TARGET_${triple^^}_LINKER=cc"
}

prepare() {
  cd "mesh-llm-$pkgver"
  [[ $(< skippy/llama_cpp/upstream.txt) == "$(git -C "$srcdir/llama.cpp" rev-parse HEAD)" ]] || {
    echo "llama.cpp $_llamacpp is not the commit in skippy/llama_cpp/upstream.txt" >&2
    return 1
  }
  [[ $(< skippy/llama_cpp/whisper-upstream.txt) == "$_whisper" ]] || {
    echo "whisper.cpp $_whisper is not the commit in skippy/llama_cpp/whisper-upstream.txt" >&2
    return 1
  }
  _cargo_env
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "mesh-llm-$pkgver"
  _cargo_env
  export ROCM_PATH=/opt/rocm
  export HIPCC=/opt/rocm/bin/hipcc
  export PATH="/opt/rocm/bin:$PATH"
  export LLAMA_STAGE_AMDGPU_TARGETS="$_amdgpu_targets"
  export LLAMA_UPSTREAM_URL="$srcdir/llama.cpp"
  export LLAMA_WORKDIR="$srcdir/llama-work"
  export WHISPER_UPSTREAM_URL="$srcdir/whisper.cpp"
  export WHISPER_WORKDIR="$srcdir/whisper-work"
  export MESH_LLM_NATIVE_RUNTIME_RANK=1000 # prefer the packaged runtime over downloads
  # ggml turns off every x86 SIMD default when SOURCE_DATE_EPOCH is set, which
  # makepkg does; without it the CPU part matches upstream's release builds,
  # which need AVX2 (Mesh-LLM/mesh-llm#2691).
  # no-link: ggml does this on purpose for reproducible builds.
  env -u SOURCE_DATE_EPOCH \
    bash skippy/scripts/package-native-runtime.sh --build --backend rocm \
    --no-model-package-tool --out "$srcdir/runtimes" \
    --id-suffix arch # tells this bundle from upstream's in `mesh-llm runtime list`
  rm -f "$srcdir"/runtimes/*.tar.gz*
}

# The bundle stores each soname (libfoo.so, .so.0, .so.0.27.0) as a full copy.
# The manifest check follows symlinks inside the bundle, so link the duplicates.
# upstream: Mesh-LLM/mesh-llm#3042
_link_sonames() {
  local f t
  for f in "$1"/lib/lib*.so "$1"/lib/lib*.so.[0-9]; do
    [[ -f $f && ! -L $f ]] || continue
    t=$(ls "$f".* 2>/dev/null | sort -V | tail -1)
    if [[ -n $t ]] && cmp -s "$f" "$t"; then
      ln -sf "${t##*/}" "$f"
    fi
  done
}

package() {
  install -d "$pkgdir/usr/lib/mesh-llm/native-runtimes"
  local dir
  dir=$(echo "$srcdir"/runtimes/meshllm-native-runtime-*-rocm*-arch)
  [[ -f $dir/manifest.json ]] || { echo "no ROCm runtime in $srcdir/runtimes" >&2; return 1; }
  cp -a "$dir" "$pkgdir/usr/lib/mesh-llm/native-runtimes/"
  _link_sonames "$pkgdir/usr/lib/mesh-llm/native-runtimes/${dir##*/}"
  install -Dm644 "$srcdir/mesh-llm-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$srcdir/llama.cpp/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-llama.cpp"
}
