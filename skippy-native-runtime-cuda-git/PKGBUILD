# Maintainer: Martin Kleinberger <martin dot kleinberger at gmail dot com>

pkgname=skippy-native-runtime-cuda-git
pkgver=0.78.0.r0.g0000000
pkgrel=1
pkgdesc="Patched llama.cpp libraries that Skippy and MeshLLM load, CUDA backend (git main)"
arch=(x86_64)
url="https://github.com/Mesh-LLM/mesh-llm"
# llama.cpp is MIT, MeshLLM's patches MIT or Apache-2.0; the bundle carries
# NVIDIA's CUDA runtime libraries (cudart, cuBLAS) under their license.
license=('MIT AND (Apache-2.0 OR MIT) AND LicenseRef-NVIDIA-CUDA')
# The bundle carries cudart and cuBLAS (RUNPATH $ORIGIN); only the driver's
# libcuda.so.1 comes from the system.
depends=(glibc libgcc libgomp libstdc++ nvidia-utils)
makedepends=(cargo cmake cuda git ninja patchelf python)
provides=(skippy-native-runtime-cuda)
conflicts=(skippy-native-runtime-cuda)
# !strip: the bundle's manifest.json checksums every library.
options=(!lto !strip !debug)
source=(
  "mesh-llm::git+https://github.com/Mesh-LLM/mesh-llm.git"
  "llama.cpp::git+https://github.com/ggml-org/llama.cpp.git"
)
sha256sums=(SKIP SKIP)

# GPU architectures of upstream's CUDA 13 release runtime (release.yml).
_cuda_architectures='75;80;86;87;89;90;100;103;120;121'

pkgver() {
  cd mesh-llm
  local ver
  ver=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
  printf "%s.r%s.g%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd mesh-llm
  # Upstream's cargo config routes builds through sccache and its own linker
  # drivers; keep only the xtool alias that the runtime script uses.
  sed -i -e '/^rustc-wrapper/d' -e '/^linker = "scripts\/cargo-linker/d' .cargo/config.toml
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd mesh-llm
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export CUDA_HOME=/opt/cuda
  export PATH="/opt/cuda/bin:$PATH"
  export LLAMA_STAGE_CUDA_ARCHITECTURES="$_cuda_architectures"
  export LLAMA_UPSTREAM_URL="$srcdir/llama.cpp"
  export LLAMA_WORKDIR="$srcdir/llama-work"
  export MESH_LLM_NATIVE_RUNTIME_RANK=1000 # prefer the packaged runtime over downloads
  # ggml turns off every x86 SIMD default when SOURCE_DATE_EPOCH is set, which
  # makepkg does; without it the CPU part matches upstream's release builds.
  env -u SOURCE_DATE_EPOCH \
    bash skippy/scripts/package-native-runtime.sh --build --backend cuda \
    --no-model-package-tool --out "$srcdir/runtimes" \
    --id-suffix arch # tells this bundle from upstream's in `mesh-llm runtime list`
  rm -f "$srcdir"/runtimes/*.tar.gz*
}

# The bundle stores each soname (libfoo.so, .so.0, .so.0.27.0) as a full copy.
# The manifest check follows symlinks inside the bundle, so link the duplicates.
_link_sonames() {
  local f t
  for f in "$1"/lib/lib*.so "$1"/lib/lib*.so.[0-9]; do
    [[ -f $f && ! -L $f ]] || continue
    t=$(ls "$f".* 2>/dev/null | sort -V | tail -1)
    if [[ -n $t ]] && cmp -s "$f" "$t"; then
      ln -sf "${t##*/}" "$f"
    fi
  done
}

package() {
  install -d "$pkgdir/usr/lib/mesh-llm/native-runtimes"
  local dir
  dir=$(echo "$srcdir"/runtimes/meshllm-native-runtime-*-cuda*-arch)
  cp -a "$dir" "$pkgdir/usr/lib/mesh-llm/native-runtimes/"
  _link_sonames "$pkgdir/usr/lib/mesh-llm/native-runtimes/${dir##*/}"
  install -Dm644 "$srcdir/mesh-llm/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$dir/licenses/NVIDIA-CUDA-LICENSE.txt" -t "$pkgdir/usr/share/licenses/$pkgname"
}
